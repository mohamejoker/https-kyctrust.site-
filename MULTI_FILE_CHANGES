// app/page.tsx
import { subscribePublished } from "@/lib/realtime"
import React from "react"
import { useEffect } from "react"

// Existing code here

const Page = () => {
  const [content, setContent] = React.useState({ ar: "", en: "" })
  const [design, setDesign] = React.useState(null)

  // Helper to refetch published content on demand
  const refetchPublished = React.useCallback(async () => {
    try {
      const r = await fetch("/api/content/published", { cache: "no-store" })
      if (!r.ok) return
      const j = await r.json()
      if (j && j.ar && j.en) {
        setContent("ar", j.ar)
        setContent("en", j.en)
        if (j.design) setDesign(j.design)
      }
    } catch {}
  }, [setContent, setDesign])

  // Subscribe to admin publish events and refetch
  useEffect(() => {
    const unsub = subscribePublished(() => {
      refetchPublished()
    })
    return () => unsub()
  }, [refetchPublished])

  // Existing code here
}

export default Page
